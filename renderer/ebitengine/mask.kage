//kage:unit pixels

package main

var Inverted float

func Fragment(dstPos vec4, srcPos vec2, col vec4) vec4 {
    maskBuffer := imageSrc0At(srcPos)
    frameBuffer := imageSrc1At(srcPos)

    maskVal := clamp(maskBuffer.r+maskBuffer.g+maskBuffer.b+maskBuffer.a, 0, 1)
    if Inverted > 0.5 {
        maskVal = 1 - maskVal
    }

    return frameBuffer * maskVal
}
